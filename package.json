{
  "name": "@servicespack/toolkit",
  "description": "Monorepo of developer toolkits and utilities under the @servicespack organization",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/servicespack/toolkit.git"
  },
  "author": "ServicesPack <https://github.com/servicespack>",
  "license": "Unlicense",
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^20.11.19",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.11.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
