  "license": "Unlicense",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@gabrielrufino/eslint-config": "^1.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.56.0",
    "express": "^4.19.2",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
