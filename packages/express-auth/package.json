{
  "name": "@servicespack/express-auth",
  "version": "1.0.0",
  "description": "Express middleware to validate the Authorization header",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
